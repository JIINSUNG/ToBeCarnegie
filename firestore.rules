rules_version = '2';

// 구글 계정으로 로그인한 사람은 누구나 쓸 수 있되, 자기 uid 문서(vaults/{uid})만 읽고 쓸 수 있다.
// 다른 사람의 Vault는 애초에 규칙상 접근이 안 된다 — 계정별 완전 분리.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vaults/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
